{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "confidence",
    "summary",
    "prompt_injection_detected",
    "findings",
    "guidance",
    "coverage_notes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "verdict": { "type": "string", "enum": ["allow", "block"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "summary": { "type": "string" },
    "prompt_injection_detected": { "type": "boolean" },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "file", "line", "evidence", "rationale"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "category": {
            "type": "string",
            "description": "Classify a cross-file chain by its end security impact; bind the finding itself to the concrete dangerous consumer or sink.",
            "enum": [
              "archive_escape", "build_hook", "coverage", "credential_access",
              "decode_execute", "filesystem", "integrity", "network",
              "obfuscation", "package_metadata", "persistence",
              "process_injection", "prompt_injection", "privilege_escalation",
              "remote_execution", "other"
            ]
          },
          "file": { "type": "string" },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Exact one-based original-file line containing the quoted evidence and dangerous operation, never a neighboring setup or closing line."
          },
          "evidence": {
            "type": "string",
            "description": "Short exact excerpt from the selected line at file and line."
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "guidance": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "assessment", "comment", "anchor_quote"],
        "properties": {
          "finding_id": { "type": "string" },
          "assessment": { "type": "string", "enum": ["likely-benign", "unclear", "concerning"] },
          "comment": { "type": "string" },
          "anchor_quote": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "coverage_notes": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string" }
    }
  }
}
